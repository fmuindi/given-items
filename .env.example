# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Public — safe to expose in the browser bundle (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never prefix with NEXT_PUBLIC_, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical app URL for this environment (used in redirects/emails).
APP_URL=http://localhost:3100

